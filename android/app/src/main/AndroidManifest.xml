<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- FIX 2.4: Xóa INTERNET + ACCESS_NETWORK_STATE — KHÔNG cần cho Phase 0.
         App là 100% Local-first, không dùng network. Nếu cần trong tương lai
         (IAP, analytics), thêm lại khi thực sự cần.
    -->

    <!-- Biometric permission (local_auth plugin) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Background service for clipboard monitoring (Phase 1 — Kotlin/IME) -->
    <!-- KHÔNG có foreground service permission ở Phase 0: clipboard capture là resume-only -->

    <application
        android:label="Smart Clipboard"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        <!-- FIX 2.4: Xóa usesCleartextTraffic — không cần cho local-first app -->
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter framework has initialized -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Receive shared intent: share text từ Chrome/Gmail/Messenger... -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- FIX 5.3 + 5.4: IME Service — đã fix meta-data typo + enabled -->
        <service
            android:name=".SmartClipboardIME"
            android:label="Smart Clipboard"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <!-- FIX 5.3: android.view_im → android.view.im (đúng chuẩn Android) -->
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method_metadata" />
        </service>

        <!-- FIX 3.2: FileProvider để share backup files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Required queries for receive_sharing_intent on Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>

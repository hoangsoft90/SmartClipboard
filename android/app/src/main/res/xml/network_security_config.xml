<?xml version="1.0" encoding="utf-8"?>
<!-- Cho phép HTTP cleartext cho tất cả domain (AdMob, Sentry, future APIs) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
